{
  "name": "@geoql/vue-doctor",
  "version": "1.9.0",
  "private": false,
  "description": "CLI auditor for Vue 3 apps. Detects anti-patterns, AI-slop, and best-practice violations via @vue/compiler-sfc + oxlint. Run with `npx -y @geoql/vue-doctor`.",
  "keywords": [
    "audit",
    "cli",
    "doctor",
    "geoql",
    "lint",
    "oxlint",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/geoql/doctor#readme",
  "bugs": {
    "url": "https://github.com/geoql/doctor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/doctor.git",
    "directory": "packages/vue-doctor"
  },
  "bin": {
    "vue-doctor": "./bin/vue-doctor.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "vp lint src",
    "lint:fix": "vp lint src --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "build": "vp pack",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@geoql/doctor-core": "workspace:^",
    "@geoql/oxlint-plugin-vue-doctor": "workspace:*",
    "cac": "^7.1.0",
    "kolorist": "^1.8.0",
    "oxlint": "^1.92.0",
    "prompts": "^2.4.2",
    "shadscan-vue": "^0.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@vue/compiler-core": "^3.5.45",
    "@vue/compiler-sfc": "^3.5.45",
    "c12": "4.0.0-rc.4",
    "oxc-parser": "^0.157.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "tinyglobby": "^0.2.17",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
