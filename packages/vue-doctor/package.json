{
  "name": "@geoql/vue-doctor",
  "version": "1.0.1",
  "private": false,
  "description": "CLI auditor for Vue 3 apps. Detects anti-patterns, AI-slop, and best-practice violations via @vue/compiler-sfc + oxlint. Run with `npx -y @geoql/vue-doctor`.",
  "keywords": [
    "audit",
    "cli",
    "doctor",
    "geoql",
    "lint",
    "oxlint",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/geoql/doctor#readme",
  "bugs": {
    "url": "https://github.com/geoql/doctor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/doctor.git",
    "directory": "packages/vue-doctor"
  },
  "bin": {
    "vue-doctor": "./bin/vue-doctor.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "vp lint src",
    "lint:fix": "vp lint src --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "build": "vp pack",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@geoql/doctor-core": "workspace:^",
    "@geoql/oxlint-plugin-vue-doctor": "workspace:*",
    "cac": "^7.0.0",
    "kolorist": "^1.8.0",
    "oxlint": "^1.67.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/prompts": "^2.4.9",
    "@vue/compiler-core": "^3.5.35",
    "@vue/compiler-sfc": "^3.5.35",
    "c12": "^4.0.0-beta.5",
    "oxc-parser": "0.133.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.1",
    "tinyglobby": "^0.2.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
